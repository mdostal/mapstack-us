# Pure fetch-scratch for the crime dataset build (scripts/fetch_crime_agencies.py,
# scripts/gen_crime_data.py) -- re-fetchable any time with a fresh API key, not
# needed for reproducibility. The derived data/crime.json and the smaller
# data/raw/crime-agency-matches.json (which agency was used per city, for
# methodology transparency) ARE committed.
data/raw/crime-cache/
data/raw/crime-offense-cache/

# Pure fetch-scratch for the natural-hazard dataset build
# (scripts/geocode_city_counties.py, scripts/gen_hazard_data.py) -- same
# posture as the crime caches above. data/hazard.json and the smaller
# data/raw/city-county-fips.json (which county each city resolved to, for
# methodology transparency) ARE committed.
data/raw/geocode-cache/
data/raw/nri-counties.json

# Pure fetch-scratch for the social-vulnerability dataset build
# (scripts/gen_svi_data.py) -- same posture as the caches above.
# data/svi.json and data/raw/city-tract-fips.json ARE committed.
data/raw/svi-cache/

# Pure fetch-scratch for the health-outcomes dataset build
# (scripts/gen_health_data.py) -- same posture as the caches above.
# data/health.json and data/raw/city-place-fips.json ARE committed.
data/raw/health-cache/

# sidecar_retention=transient (epic power-user-tab): HTML sidecars/index
# and generated design PNGs are regenerated on demand, not committed.
.pHive/epics/power-user-tab/docs/*.html
.pHive/epics/power-user-tab/index.html
.pHive/epics/**/docs/*.png

# Compiled at build time by scripts/build-sqlite.ts (see "prebuild"/"predev"
# in package.json) -- deterministic from data/*.json + the DATASETS
# registry, not source, not needed for reproducibility.
public/data.sqlite
public/sql-wasm-browser.wasm
