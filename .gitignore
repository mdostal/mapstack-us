# Pure fetch-scratch for the crime dataset build (scripts/fetch_crime_agencies.py,
# scripts/gen_crime_data.py) -- re-fetchable any time with a fresh API key, not
# needed for reproducibility. The derived data/crime.json and the smaller
# data/raw/crime-agency-matches.json (which agency was used per city, for
# methodology transparency) ARE committed.
data/raw/crime-cache/
data/raw/crime-offense-cache/

# Pure fetch-scratch for the natural-hazard dataset build
# (scripts/geocode_city_counties.py, scripts/gen_hazard_data.py) -- same
# posture as the crime caches above. data/hazard.json and the smaller
# data/raw/city-county-fips.json (which county each city resolved to, for
# methodology transparency) ARE committed.
data/raw/geocode-cache/
data/raw/nri-counties.json

# Pure fetch-scratch for the social-vulnerability dataset build
# (scripts/gen_svi_data.py) -- same posture as the caches above.
# data/svi.json and data/raw/city-tract-fips.json ARE committed.
data/raw/svi-cache/

# Pure fetch-scratch for the health-outcomes dataset build
# (scripts/gen_health_data.py) -- same posture as the caches above.
# data/health.json and data/raw/city-place-fips.json ARE committed.
data/raw/health-cache/

# Pure fetch-scratch for the food-access dataset build
# (scripts/geocode_city_tracts_2010.py, scripts/gen_food_access_data.py) --
# same posture as the caches above. data/food-access.json and
# data/raw/city-tract-fips-2010.json ARE committed.
data/raw/geocode-2010-cache/
data/raw/food-access-cache/

# Pure fetch-scratch for the housing-supply dataset build
# (scripts/gen_housing_inventory_data.py) -- same posture as the caches
# above. data/housing-inventory.json IS committed.
data/raw/housing-inventory-cache/

# Pure fetch-scratch for the housing-market-speed dataset build
# (scripts/gen_days_on_market_data.py) -- same posture as the caches
# above. data/days-on-market.json IS committed.
data/raw/days-on-market-cache/

# Pure fetch-scratch for the traffic-safety dataset build
# (scripts/gen_traffic_fatalities_data.py) -- same posture as the caches
# above. data/traffic-fatalities.json IS committed.
data/raw/traffic-cache/

# Pure fetch-scratch for the transit-access dataset build
# (geocode_city_urban_areas.py + gen_transit_access_data.py) -- same
# posture as the caches above. data/raw/city-urban-area.json AND
# data/transit-access.json ARE committed (small derived crosswalk/data).
data/raw/urban-area-geocode-cache/
data/raw/transit-cache/

# Pure fetch-scratch for the walkability dataset build
# (scripts/gen_walkability_data.py) -- same posture as the caches above.
# data/walkability.json IS committed.
data/raw/walkability-cache/

# Pure fetch-scratch for the park-access dataset build
# (scripts/gen_parks_data.py) -- same posture as the caches above.
# data/parks.json IS committed.
data/raw/parks-cache/

# Pure fetch-scratch for the broadband-access dataset build
# (scripts/gen_broadband_data.py) -- same posture as the caches above.
# data/broadband.json IS committed.
data/raw/broadband-cache/

# Pure fetch-scratch for the median-income dataset build
# (scripts/gen_income_data.py) -- same posture as the caches above.
# data/income.json IS committed.
data/raw/income-cache/

# Pure fetch-scratch for the housing-cost-burden dataset build
# (scripts/gen_housing_cost_burden_data.py) -- same posture as the
# caches above. data/housing-cost-burden.json IS committed.
data/raw/housing-cost-burden-cache/

# Pure fetch-scratch for the extreme-heat dataset build
# (scripts/fetch_heat_stations.py, scripts/gen_heat_data.py) -- same
# posture as the caches above. data/heat.json AND
# data/raw/heat-station-matches.json ARE committed (the real
# city->station matching decision, same posture as
# data/raw/crime-agency-matches.json).
data/raw/heat-cache/

# Pure fetch-scratch for the combined sales-tax-rate dataset build
# (scripts/gen_sales_tax_data.py) -- same posture as the caches above.
# data/sales-tax.json IS committed.
data/raw/sales-tax-cache/

# sidecar_retention=transient (epic power-user-tab): HTML sidecars/index
# and generated design PNGs are regenerated on demand, not committed.
.pHive/epics/power-user-tab/docs/*.html
.pHive/epics/power-user-tab/index.html
.pHive/epics/**/docs/*.png

# Compiled at build time by scripts/build-sqlite.ts (see "prebuild"/"predev"
# in package.json) -- deterministic from data/*.json + the DATASETS
# registry, not source, not needed for reproducibility.
public/data.sqlite
public/sql-wasm-browser.wasm
