# Copy to .env and fill in the keys you need. None of these are required to
# run the app itself -- `pnpm dev`/`pnpm build` work with zero keys against
# the already-committed data/*.json files. They're only read by the one-off
# Python scripts under scripts/ that regenerate that data from each real
# source. See the "API keys" section of README.md for the fuller picture.
#
# Never commit a real value here -- .env itself is gitignored, and
# `pnpm test:secrets` scans for these exact key shapes landing in the repo
# or the built client bundle.

# Census Bureau API -- powers income.ts, property-tax.ts, population-change.ts,
# housing-cost-burden.ts, average-wage.ts, business-density.ts.
# Free, instant, self-serve: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# FBI Crime Data Explorer (via api.data.gov) -- powers crime.ts, hate-crime.ts.
# Free, instant, self-serve: https://api.data.gov/signup/
FBI_CRIME_API_KEY=

# BLS (Bureau of Labor Statistics) API -- powers unemployment.ts.
# Free, instant, self-serve: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# BEA (Bureau of Economic Analysis) API -- powers cost-of-living.ts.
# Free, instant, self-serve: https://apps.bea.gov/API/signup/
BEA_API_KEY=

# EIA (U.S. Energy Information Administration) API v2 -- powers electricity-cost.ts.
# Free, instant, self-serve: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
